---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const phone = '010-0000-0000';

const products = [
  { icon: '💳', title: '카드단말기', desc: '유선·무선·블루투스·토스단말기까지. VAN사 수수료 비교로 최저가 제공.' },
  { icon: '🖥️', title: '포스기(POS)', desc: '주문·결제·매출·재고를 한 번에. 배달앱·오프라인 통합 대시보드.' },
  { icon: '🤖', title: '키오스크', desc: '무인 주문·결제 시스템으로 인건비 절감. 소형·대형 모두 지원.' },
  { icon: '📋', title: '테이블오더', desc: 'QR·태블릿 기반 주문 시스템. 객단가 상승과 홀 인력 절감 동시에.' },
  { icon: '📷', title: 'CCTV', desc: 'HD~4K 고화질 + AI 움직임 감지. 스마트폰으로 매장 실시간 확인.' },
  { icon: '🏭', title: '밴딩머신', desc: '판매 수익 + 광고 수익. 23.4인치 터치스크린 자동판매기.' },
];

const regions = [
  { emoji: '🏙', name: '서울', slug: 'seoul' },
  { emoji: '🌿', name: '경기', slug: 'gyeonggi' },
  { emoji: '✈️', name: '인천', slug: 'incheon' },
  { emoji: '⚓', name: '부산', slug: 'busan' },
  { emoji: '🏭', name: '대구', slug: 'daegu' },
  { emoji: '🔬', name: '대전', slug: 'daejeon' },
  { emoji: '🌸', name: '광주', slug: 'gwangju' },
  { emoji: '🔧', name: '울산', slug: 'ulsan' },
  { emoji: '🏛', name: '세종', slug: 'sejong' },
  { emoji: '🏔', name: '강원', slug: 'gangwon' },
  { emoji: '🌻', name: '충북', slug: 'chungbuk' },
  { emoji: '🌊', name: '충남', slug: 'chungnam' },
  { emoji: '🌾', name: '전북', slug: 'jeonbuk' },
  { emoji: '🍵', name: '전남', slug: 'jeonnam' },
  { emoji: '🍎', name: '경북', slug: 'gyeongbuk' },
  { emoji: '🌊', name: '경남', slug: 'gyeongnam' },
  { emoji: '🌺', name: '제주', slug: 'jeju' },
];

const features = [
  { num: '01', title: '업종별 1:1 컨설팅', desc: '음식점·카페·편의점·미용실 등 업종 특성에 맞춰 최적의 장비 조합을 제안합니다.' },
  { num: '02', title: '원스톱 통합 설치', desc: '카드단말기부터 CCTV까지 매장에 필요한 모든 장비를 하루에 한 번에 설치합니다.' },
  { num: '03', title: 'VAN사 수수료 절감', desc: 'VAN사별 수수료를 비교 분석해 가장 유리한 조건을 찾아드려 연 수십만원 절약.' },
  { num: '04', title: '24시간 A/S 체계', desc: '장애 발생 시 원격 지원으로 즉시 해결. 필요 시 현장 출동까지 책임집니다.' },
  { num: '05', title: '맞춤형 UI 설정', desc: '매장에 딱 맞는 메뉴 배치와 결제 동선을 직접 설계해 계산 시간을 단축합니다.' },
  { num: '06', title: 'AI 매출 분석 리포트', desc: '요일별·시간대별 방문 패턴을 분석해 최적의 운영 시간을 제안합니다.' },
];

const reviews = [
  { badge: '매출 40%↑', title: '카드단말기 교체 후 매출 급증', body: '수수료 비교까지 해주셔서 연간 60만원 절약하고 매출도 올랐어요.', author: '서울 강남구 카페 사장님' },
  { badge: '인건비 50%↓', title: '키오스크 설치로 인건비 반토막', body: '테이블오더+키오스크 조합으로 홀 직원 2명에서 1명으로. 서비스 품질도 유지됩니다.', author: '부산 해운대구 음식점 사장님' },
  { badge: '빠른 설치', title: '전화 한 통으로 설치 완료', body: '급하게 필요했는데 빠르게 설치해주셨어요. 바로 영업 시작할 수 있었습니다.', author: '대전 유성구 음식점 사장님' },
  { badge: 'CCTV 만족', title: '스마트폰으로 매장 실시간 확인', body: '매장에 없어도 어디서든 확인 가능. 화질도 선명하고 알림도 정확해요.', author: '서울 마포구 음식점 사장님' },
  { badge: '객단가↑', title: '테이블오더 도입 후 객단가 25% 상승', body: '메뉴 사진 보고 추가 주문이 늘었어요. 직원 호출도 줄어서 편해요.', author: '경기 분당구 치킨집 사장님' },
  { badge: '관리 편함', title: '매출 관리가 이렇게 쉬울 줄이야', body: '일별·월별 매출 자동 리포트가 세무사한테 보내기도 편합니다.', author: '서울 송파구 베이커리 사장님' },
];

// Blog posts (latest 3)
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="reveal">
        <span class="eyebrow">전국 매장 설비 설치 플랫폼</span>
        <h1 class="hero-title">
          우리 매장에<br />
          <span class="underline">딱 맞는 장비를</span><br />
          <em>빠르게, 정확하게.</em>
        </h1>
        <p class="hero-sub">
          카드단말기부터 포스기, 키오스크, 테이블오더, CCTV까지.
          업종과 동선에 맞춘 1:1 컨설팅으로 매장 운영을 한 단계 끌어올립니다.
        </p>
        <div class="hero-ctas">
          <a href="#contact" class="btn btn-primary">
            무료 견적 받기 <span>→</span>
          </a>
          <a href="#products" class="btn btn-ghost">제품 둘러보기</a>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="hero-card hero-card-1">
          <div class="stat-num">350+</div>
          <div class="stat-label">누적 설치 매장</div>
        </div>
        <div class="hero-card hero-card-2">
          <div class="stat-num">98<span style="font-size:32px">%</span></div>
          <div class="stat-label">설치 만족도</div>
        </div>
        <div class="hero-card hero-card-3">
          <div class="stat-num" style="font-size:34px">⚡ 당일</div>
          <div class="stat-label" style="color:var(--muted)">상담·출장 가능</div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar">
    <div class="container stats-grid">
      <div class="stat-item">
        <div class="n">5,000<span>+</span></div>
        <div class="l">전국 읍면동 출장 가능</div>
      </div>
      <div class="stat-item">
        <div class="n">94<span>%</span></div>
        <div class="l">당일·익일 설치율</div>
      </div>
      <div class="stat-item">
        <div class="n">87<span>%</span></div>
        <div class="l">재계약·추천률</div>
      </div>
      <div class="stat-item">
        <div class="n">24<span>H</span></div>
        <div class="l">A/S 대응 체계</div>
      </div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <section class="block" id="products">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-tag">Products</div>
        <h2 class="section-title">매장에 필요한 모든 장비,<br /><em>한 곳에서</em> 설치합니다</h2>
        <p class="section-desc">1인 매장부터 프랜차이즈까지. 업종과 매장 규모에 맞춰 최적의 조합을 제안합니다.</p>
      </div>

      <div class="products-grid">
        {products.map((p) => (
          <div class="product reveal">
            <span class="product-arrow">↗</span>
            <div class="product-icon">{p.icon}</div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REGIONS -->
  <section class="regions" id="regions">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-tag">Service Area</div>
        <h2 class="section-title">전국 어디든<br /><em>직접 방문</em>해 설치합니다</h2>
        <p class="section-desc">17개 시·도, 5,000+ 읍면동까지 직접 출장. 우리 동네 사례가 궁금하다면 클릭해 보세요.</p>
      </div>

      <div class="region-grid reveal">
        {regions.map((r) => (
          <a href={`/blog?region=${r.slug}`} class="region-chip">
            <span class="emoji">{r.emoji}</span>
            {r.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="block features" id="features">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-tag">Why opsoult</div>
        <h2 class="section-title">단순 장비 판매가 아닙니다<br /><em>매장 운영이 달라집니다</em></h2>
      </div>

      <div class="feature-grid">
        {features.map((f) => (
          <div class="feature reveal">
            <div class="feature-num">— {f.num}</div>
            <h4>{f.title}</h4>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST BLOG (only show if posts exist) -->
  {latestPosts.length > 0 && (
    <section class="block">
      <div class="container">
        <div class="section-head reveal" style="display:flex; justify-content:space-between; align-items:end; max-width:none;">
          <div>
            <div class="section-tag">Latest</div>
            <h2 class="section-title">최근 설치 사례</h2>
          </div>
          <a href="/blog" class="btn btn-ghost" style="padding:10px 20px; font-size:14px;">전체 보기 →</a>
        </div>

        <div class="posts-grid">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="post-card reveal">
              <div class="post-emoji">{post.data.heroEmoji}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- REVIEWS -->
  <section class="block" id="reviews" style="background:var(--paper-2);">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-tag">Real Reviews</div>
        <h2 class="section-title">전국 사장님들의 <em>생생한 후기</em></h2>
      </div>

      <div class="reviews-track">
        {reviews.map((r) => (
          <div class="review">
            <div class="review-stars">★★★★★</div>
            <span class="review-badge">{r.badge}</span>
            <h5>{r.title}</h5>
            <p>{r.body}</p>
            <div class="review-author">{r.author}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-block" id="contact">
    <div class="container">
      <h2>지금 바로<br /><em>무료 상담</em> 받아보세요</h2>
      <p>카드단말기·포스기·키오스크·테이블오더·CCTV<br />매장에 필요한 모든 장비, 한 통화로 해결.</p>
      <a href={`tel:${phone}`} class="cta-phone">
        📞 {phone}
      </a>
      <div class="cta-sub">평일 09:00 ~ 21:00 · 카카오톡 상담 가능</div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero { padding: 80px 0 60px; position: relative; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    border-radius: 100px;
    font-size: 13px; font-weight: 500;
    color: var(--ink-2);
  }
  .eyebrow::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .5; transform: scale(1.3); }
  }
  .hero-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(38px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 20px 0 24px;
  }
  .hero-title em { font-style: italic; color: var(--accent); font-weight: 600; }
  .hero-title .underline { position: relative; display: inline-block; }
  .hero-title .underline::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 4px;
    height: 10px;
    background: var(--accent-2);
    opacity: .5;
    z-index: -1;
  }
  .hero-sub {
    font-size: 18px; color: var(--ink-2);
    max-width: 520px;
    margin-bottom: 36px;
  }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }

  /* Hero visual */
  .hero-visual {
    position: relative;
    aspect-ratio: 4/5;
    max-width: 460px;
    margin-left: auto;
  }
  .hero-card {
    position: absolute;
    color: var(--paper);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: 0 20px 60px rgba(12,15,20,0.2);
  }
  .hero-card-1 { top: 0; left: 0; width: 70%; background: var(--ink); transform: rotate(-3deg); }
  .hero-card-2 { bottom: 10%; right: 0; width: 65%; background: var(--accent); transform: rotate(4deg); }
  .hero-card-3 {
    bottom: 0; left: 15%; width: 50%;
    background: var(--paper-2);
    color: var(--ink);
    border: 1px solid var(--line);
    transform: rotate(-1deg);
  }
  .stat-num {
    font-family: 'Fraunces', serif;
    font-size: 54px; font-weight: 800;
    line-height: 1; letter-spacing: -0.04em;
  }
  .stat-label { font-size: 13px; opacity: .8; margin-top: 8px; }

  /* STATS BAR */
  .stats-bar {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 40px 0;
    background: var(--paper-2);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
  }
  .stat-item .n {
    font-family: 'Fraunces', serif;
    font-size: 42px; font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .stat-item .n span { color: var(--accent); }
  .stat-item .l {
    font-size: 13px; color: var(--muted);
    margin-top: 4px; letter-spacing: .02em;
  }

  /* PRODUCTS */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .product {
    background: var(--paper-2);
    border-radius: var(--radius);
    padding: 32px 28px;
    border: 1px solid transparent;
    transition: all .3s;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }
  .product:hover {
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-4px);
    border-color: var(--ink);
  }
  .product-icon {
    width: 56px; height: 56px;
    border-radius: 14px;
    background: var(--paper);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
    margin-bottom: 20px;
    transition: background .3s;
  }
  .product:hover .product-icon { background: var(--accent); }
  .product h3 {
    font-family: 'Fraunces', serif;
    font-size: 22px; font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .product p { font-size: 14px; color: var(--muted); line-height: 1.55; }
  .product:hover p { color: rgba(245,241,234,0.7); }
  .product-arrow {
    position: absolute; top: 28px; right: 28px;
    font-size: 20px; opacity: 0;
    transition: opacity .3s, transform .3s;
  }
  .product:hover .product-arrow { opacity: 1; transform: translate(4px, -4px); }

  /* REGIONS */
  .regions {
    background: var(--ink);
    color: var(--paper);
    padding: 100px 0;
  }
  .regions :global(.section-title) { color: var(--paper); }
  .regions :global(.section-desc) { color: rgba(245,241,234,0.7); }
  .regions :global(.section-tag) { color: var(--accent-2); }
  .region-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-top: 40px;
  }
  .region-chip {
    padding: 18px 14px;
    border: 1px solid rgba(245,241,234,0.15);
    border-radius: 12px;
    text-align: center;
    font-size: 14px; font-weight: 500;
    transition: all .2s;
    cursor: pointer;
  }
  .region-chip:hover {
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .region-chip .emoji { display: block; font-size: 22px; margin-bottom: 6px; }

  /* FEATURES */
  .features { background: var(--paper-2); }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .feature {
    background: var(--paper);
    padding: 40px 32px;
    transition: background .2s;
  }
  .feature:hover { background: #fffbf3; }
  .feature-num {
    font-family: 'Fraunces', serif;
    font-size: 14px;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 16px;
    letter-spacing: 0.05em;
  }
  .feature h4 {
    font-family: 'Fraunces', serif;
    font-size: 24px; font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .feature p { font-size: 14.5px; color: var(--muted); line-height: 1.6; }

  /* POSTS */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .post-card {
    background: var(--paper-2);
    border-radius: var(--radius);
    padding: 32px 28px;
    transition: all .3s;
    border: 1px solid transparent;
    display: block;
  }
  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .post-emoji { font-size: 36px; margin-bottom: 16px; }
  .post-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 20px; font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .post-card p {
    font-size: 14px; color: var(--muted);
